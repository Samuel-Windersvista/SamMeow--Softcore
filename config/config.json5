{
	general: {
		enabled: true, // 启用或禁用本MOD
		debug: false, // 调试模式（当前未实现实际功能）
	},
	secureContainersOptions: {
		// 安全容器选项总开关。灵感来自 Trap's Progressive Stash，从头重做。默认关闭以免影响已有存档。
		enabled: true, // 启用安全容器修改
		progressiveContainers: {
			// 新存档从 2x2 腰包开始，通过复杂昂贵但公平有趣的自定义容器制作逐步升级到 Gamma。
			enabled: true,
			// 收藏家任务 10 级即可接取。不再需要完成所有前置任务，只需要交物品。但别以为会很简单 —— 还有一个额外的终局肝度条件等着你。比原版"肝到 55 级"有趣多了。
			collectorQuestRedone: true,
		},
		// 腰包变为 2x4，Alpha 变为 3x3（等同 EoD 版），Beta 3x4，Epsilon 3x5，Gamma 4x5，Kappa 5x5
		biggerContainers: true,
	},
	hideoutOptions: {
		// 藏身处选项总开关
		enabled: true,
		stashOptions: {
			// 仓库选项总开关。灵感来自 Trap's Progressive Stash。
			enabled: true,
			// 所有新存档从 1 级仓库开始
			progressiveStash: true,
			// 扩大仓库容量，从 28/38/48/68 行提升至 50/100/150/200 行
			biggerStash: true,
			// 降低各阶段建造所需的现金需求，减少 10 倍
			lessCurrencyForConstruction: true,
			// 降低建造所需的商人忠诚度要求（Prapor、Ragman、Peacekeeper），各减 1 级
			easierLoyalty: true,
		},
		hideoutContainers: {
			enabled: true,
			// 小幅增强基础藏身处容器：药箱 7x7 -> 10x10，保温袋 8x8 -> 10x10，弹匣箱 7x7 -> 7x10，物品箱 8x8 -> 10x10，武器箱 5x10 -> 6x10，钥匙工具 -> 5x5
			biggerHideoutContainers: true,
			// 大幅增强 SICC 包，使其真正成为文档包的升级替代品。同时允许 SICC 包放入钥匙工具。在 Softcore 的改动下这是终局物品，跳蚤市场很难买到，所以无所谓。允许的物品列表：比特币、GP 币、Veritas 吉他拨片、门禁卡包、信息、钥匙、地图、金钱、Prokill 奖章项链、黄金骷髅戒指、BEAR 狗牌、USEC 狗牌、安全闪存盘、钥匙工具
			siccCaseBuff: true,
		},
		fasterBitcoinFarming: {
			// 修改基础挖矿时间并大幅提升每张 GPU 的效率（从约 4% 提升至 50%）。每张额外的 GPU 对挖矿速度的影响远超原版，3 级比特币矿场收益极高。原版对比 — 1 张 GPU：40 小时 17 分钟，50 张 GPU：13 小时 20 分钟/个。Softcore 默认设置 — 1 张 GPU：20 小时 8 分钟，50 张 GPU：47 分钟/个。setBitcoinPriceTo100k 选项将比特币价格从 0.13 版本的 225k 回调至 0.12 版本的 100k，这是预期平衡方式
			enabled: true,
			setBitcoinPriceTo100k: true,
			baseBitcoinTimeMultiplier: 2.0,
			gpuEfficiency: 0.5,
		},
		fasterCraftingTime: {
			// 大幅加快除比特币、私酒和纯净水外的所有配方制作速度
			enabled: true,
			baseCraftingTimeMultiplier: 100,
			hideoutSkillExpFix: {
				// 实验性：针对藏身处管理技能的制作时间经验值修正
				enabled: true,
				hideoutSkillExpMultiplier: 10,
			},
			fasterMoonshineProduction: {
				// 加快私酒生产
				enabled: true,
				baseCraftingTimeMultiplier: 10,
			},
			fasterPurifiedWaterProduction: {
				// 加快纯净水生产
				enabled: true,
				baseCraftingTimeMultiplier: 10,
			},
			fasterCultistCircle: {
				enabled: true,
				baseCraftingTimeMultiplier: 10,
			},
		},
		fasterHideoutConstruction: {
			// 大幅加快藏身处设施建设速度
			enabled: true,
			hideoutConstructionTimeMultiplier: 100,
		},
		fuelConsumption: {
			// 为平衡以上加速功能，燃料消耗速率同步提升。现在你终于需要稍微考虑一下燃料经济了 —— 但真的只是稍微
			enabled: true,
			fuelConsumptionMultiplier: 10,
		},
		scavCaseOptions: {
			// 食人魔箱子选项总开关
			enabled: true,
			// 建议始终开启。可视为针对食人魔箱子奖励池的 SPT 补丁/修复。保守过滤掉大量垃圾/无用物品（如价值低于 5k 的武器专用模组、机械瞄具、导气管、螺纹适配器、弹匣、镜架等）以及 OP/Boss/开发者/损坏/任务等物品，确保每次回收都能得到有价值或有用的东西。非常安全，即使不需要其他功能也推荐开启。此过滤同样适用于 Fence。
			betterRewards: true,
			fasterScavcase: {
				// 加快食人魔箱子回收速度，倍率如下。x10 感觉刚刚好
				enabled: true,
				speedMultiplier: 10,
			},
			// 食人魔箱子奖励大重做，单人体验极佳。将所有现金回收改为酒精回收，更贴合世界观（Pevko 啤酒 -> 伏特加 -> 威士忌 -> Moonshine 私酒 -> 情报）。完全重做内部奖励分级（普通：20,000 以下，稀有：20,000-60,000，超稀有：60,000-1,200,000），让每种回收等级都有价值、公平且可针对性获取不同等级的物品。Pevko 啤酒最快，给 2-3 件普通物品。伏特加给 3-4 件普通物品，有概率额外 1 件稀有。威士忌给 4-5 件普通物品 + 1-2 件稀有。Moonshine 私酒适合赌博，给 1-3 件普通 + 0-3 件稀有 + 0-2 件超稀有。情报文件夹最稳定，给 2-3 件普通 + 3-5 件稀有 + 0-1 件超稀有。
			rebalance: true,
		},
		// 允许在严重肌肉酸痛状态下继续健身训练（效率 75%）
		allowGymTrainingWithMusclePain: true,
	},
	economyOptions: {
		// 经济选项总开关
		enabled: true,
		// 完全禁用跳蚤市场，获得真正的硬核体验。仍然可以打开界面查看商人报价。开启后将覆盖下方所有跳蚤市场相关选项
		disableFleaMarketCompletely: false,
		priceRebalance: {
			// 本MOD的核心功能。彻底移除 SPT 从线上抓取的跳蚤价格快照，将所有物品价格与游戏内置手册/商人数据对齐。所有其他功能都基于此进行平衡。不建议关闭
			enabled: true,
			// 修复重要物品的定价，如情报文件夹和军事U盘
			itemFixes: true,
		},
		pacifistFleaMarket: {
			// 本MOD的核心功能。跳蚤市场上只能购买药品、以物易物类物品、食品和信息类物品。使用硬编码 fleaWhitelist 数组作为过滤器。不建议关闭
			enabled: true,
			// 少量用于制作和商人交易的物品可在跳蚤购买，使用硬编码 itemWhitelist 数组
			whitelist: {
				enabled: true,
				priceMultiplier: 2,
			},
			questKeys: {
				// 随机刷新类任务钥匙可在跳蚤购买，使用硬编码 questKeys 数组
				enabled: true,
				priceMultiplier: 2,
			},
			markedKeys: {
				// 标记房间钥匙可在跳蚤市场购买
				enabled: true,
				priceMultiplier: 2,
			},
		},
		barterEconomy: {
			// 本MOD的核心功能。跳蚤市场上的物品只能用其他随机战局内发现或制作的物品交换购买。使用硬编码 fleaBarterBlacklist 数组作为过滤器（药品、以物易物类、食品和信息类允许，刺激剂和燃料除外）。不建议关闭
			enabled: true,
			// 允许少量随机比例的挂单可使用现金购买。0 表示纯粹以物易物经济（最便宜的物品如 AA 电池除外，这是 SPT-AKI 的限制）。这是本MOD推荐的游玩方式，但有时可能太难。5% 是个不错的数字，可以稍微降低物品死锁的概率。推荐范围：0-15
			cashOffersPercentage: 0,
			// 物品挂牌价格与交换价值之间的浮动百分比（±）。数值越大，交易越狂野多样 —— 例如你可能看到一个除颤器（价值 224k）被要求用狮子雕像（价值 162k）或坦克电池（价值 330k）交换。这是让整个MOD运转起来的核心功能，带来随机、有趣、引人入胜的体验，模拟战乱社会中的讨价还价。你可能走运捡到好交易，也可能急需某件物品但它被要求用你仅有的一件昂贵物品来交换。同时更大的浮动意味着更容易遇到你有对应物品的报价，交易更顺畅。推荐范围：20-50
			barterPriceVariance: 50,
			offerItemCount: {
				// 每种物品最多 20 个不同的交换报价。数值太低会以某种方式破坏 SPT 服务端，导致交易完成时持续报客户端错误。更多的随机交易差异 = 更有趣
				min: 10,
				max: 20,
			},
			nonStackableCount: {
				// 单个报价中每种物品最多 2 件。感觉不错。多搜刮东西，总有用得上的时候
				min: 1,
				max: 2,
			},
			// 限制交换报价中要求的物品种类数量上限。默认为最多 2 换 1
			itemCountMax: 2,
		},
		otherFleaMarketChanges: {
			// 其他跳蚤市场选项总开关
			enabled: true,
			// 不建议修改，使用下方的 TraderChanges 选项。如果将此选项改为开启，将允许在跳蚤市场出售物品（默认禁止出售）。允许出售武器和其他被 Softcore 屏蔽的物品，如同原版。未经测试和平衡调整，不建议启用
			sellingOnFlea: false,
			// 跳蚤市场开放的 PMC 等级
			fleaMarketOpenAtLevel: 5,
			// 略微提高跳蚤市场价格以鼓励搜刮和制作，而非在跳蚤购买一切。开启以物易物经济和价格浮动后，你仍然能得到大量低于实际价值的超值交易。加油倒爷！
			fleaPricesIncreased: 1.3,
			// 跳蚤市场只上架全新状态的物品
			fleaPristineItems: true,
			// 纯爷们别改这个。由于价格浮动机制，关闭此选项等同于无限刷钱的作弊行为
			onlyFoundInRaidItemsAllowedForBarters: true,
		},
	},
	traderChanges: {
		// 商人选项总开关
		enabled: true,
		// 调整商人出售物品的收购价格（1 级忠诚度时：Prapor 50%->60%，Therapist 63%->64%，Ragman 62%->63%，Jaeger 60%->62%，Mechanic 56%->61%，Peacekeeper 45%->58%，Skier 49%->59%）。每升一级忠诚度额外增加 5% 收购价，例如 LL4 Prapor 将以物品价值的 75% 收购
		betterSalesToTraders: true,
		// 削弱 Therapist 的收购类别（不再收所有以物易物类物品，只收药品和家庭用品，增加商人差异化），允许 Ragman 收购贵重品，允许 Skier 收购信息物品
		alternativeCategories: true,
		pacifistFence: {
			// 与本MOD主题保持一致，Fence 也只出售和平主义物品。价格取决于 scav 业报值，6.0 业报时售价约等于 Therapist 向你收购的价格
			enabled: true,
			numberOfFenceOffers: 30,
		},
		// 重平衡藏身处容器的成本和交换，使其价格合理公平。同时修改了 LEDX 狗牌交换
		reasonablyPricedCases: true,
		// 实验性选项：让 Skier 所有交易和任务奖励使用欧元，主要是为了趣味性和多样性。会相应调整库存和忠诚度要求。默认关闭，因为开启后需要修改已有存档的 salesSum（可手动操作：在 %profileID%.json 中找到 TradersInfo，在 58330581ace78e27b8b10cee 键下将 salesSum 除以 115，不留余数），除非从新档开始就启用
		skierUsesEuros: true,
		biggerLimits: {
			// 提高从商人处购买物品的数量上限
			enabled: true,
			multiplier: 2.0,
		},
	},
	craftingChanges: {
		// 制作配方选项总开关
		enabled: true,
		// 对制作配方进行大规模重平衡，围绕组件稀有度、实用性、商人价格和纯"设定"逻辑进行调整。有削弱但更多的是大幅增强。核心理念是让大多数制作配方变得有用且/或有利可图
		craftingRebalance: true,
		// 新增符合世界观设定且平衡的自定义制作配方：3-b-TG、肾上腺素、L1、AHF1-M、CALOK-B、检眼镜、Zagustin、Obdolbos、OLOLO
		additionalCraftingRecipes: true,
	},
	insuranceChanges: {
		// 重做保险系统，让两位商人各司其职。Prapor 定位为"可靠"选择：80% 返还率，保费 25%。Therapist 返还率 60% 但保费仅 5%，适合快速回收廉价任务装备或纯赌博。同时保险存储时间延长至一整月，保留武器配件的概率提升至 50%
		enabled: true,
		praporInsuranceChanges: {
			enabled: true,
			returnChance: 80,
			returnTime: {
				min: 0,
				max: 0,
			},
			insuranceCostPercentage: 25,
		},
		therapistInsuranceChanges: {
			enabled: true,
			returnChance: 60,
			returnTime: {
				min: 0,
				max: 0,
			},
			insuranceCostPercentage: 5,
		},
	},
	otherTweaks: {
		// 其他杂项选项总开关
		enabled: true,
		// 增强活力、狙击、手术、弹匣训练、武器保养技能的经验获取（x10）
		skillExpBuffs: true,
		// ZiD SP-81 26x75 信号手枪可放入特殊栏位，死亡不掉落
		signalPistolInSpecialSlots: true,
		// 恢复 BSG 移除的物品检视机制（所有物品初始变为未检视状态）
		unexaminedItemsAreBack: true,
		// 加快物品检视速度，配合 unexaminedItemsAreBack 使用效果更佳
		fasterExamineTime: true,
		// 移除背包限制（弹药箱、药箱等容器和其他背包可放入背包中）。再也不会看到 314 房里有个捡不起来的药箱了……
		removeBackpackRestrictions: true,
		// 移除昂贵物品的丢弃限制（BSG 反 RMT 措施）
		removeDiscardLimit: true,
		// Reshala 必定携带金 TT
		reshalaAlwaysHasGoldenTT: true,
		// 增大弹药堆叠数量
		biggerAmmoStacks: {
			enabled: true,
			stackMultiplier: 10,
			// 修复 Boss 生成时携带隐藏容器中大量弹药导致超重的问题。这是一个简易修复，将弹药重量除以堆叠倍率
			botAmmoStackFix: true,
		},
		// 优化任务起步体验（Crisis）。Drip-Out 系列任务要求降低 5 倍
		questChanges: true,
		// 移除进图物品携带限制
		removeRaidItemLimits: true,
		// 卢布堆叠至 100 万，欧元和美元堆叠至 10 万，GP 币堆叠至 100
		biggerCurrencyStacks: true,
		// 允许 1x1 小型容器（狗牌包、注射器包、钥匙工具、门禁卡包、简易钱包、WZ 钱包）放入特殊栏位
		smallContainersInSpecialSlots: true,
	},
}
